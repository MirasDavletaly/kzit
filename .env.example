OPENROUTER_API_KEY=replace-with-your-own-value
PORT=3121
# audio-capable model: transcription + translation in one call
MODEL_TRANSLATE=google/gemini-3.5-flash-lite
# text-to-speech model
MODEL_TTS=google/gemini-3.8-flash-lite-tts
LOG_KEY=replace-with-your-own-value
LOG_AUDIO_DAYS=14
VOICE_IT=Charon
VOICE_RU=Kore
# live engine (Gemini Live Translate, streaming); without it the server uses the classic engine
GEMINI_API_KEY=
# ENGINE=classic
# MODEL_LIVE=gemini-3.5-live-translate-preview
